# Copiar a .env y reemplazar los placeholders. .env NO se versiona.
# Nunca escribir claves reales en este archivo.

# Superusuario del contenedor (solo desarrollo local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_clave_superusuario
POSTGRES_DB=repuestos_exactos

# Clave del rol de conexion del backend (app_backend_user). La usa V000 via psql -v.
APP_BACKEND_PASSWORD=CAMBIAR_clave_backend

# Clave comun de los usuarios de demostracion. La usan las semillas via psql -v.
CLAVE_DEMO=CAMBIAR_clave_demo
